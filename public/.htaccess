# Copiado a out/ en cada `next build` (export estático para cPanel).

# BEGIN cPanel-generated php ini directives, do not edit
# Manual editing of this file may result in unexpected behavior.
# To make changes to this file, use the cPanel MultiPHP INI Editor (Home >> Software >> MultiPHP INI Editor)
# For more information, read our documentation (https://go.cpanel.net/EA4ModifyINI)
<IfModule php8_module>
   php_value error_log "/home/ryviwewd/logs/php.error.log"
   php_flag log_errors On
</IfModule>
<IfModule lsapi_module>
   php_value error_log "/home/ryviwewd/logs/php.error.log"
   php_flag log_errors On
</IfModule>
# END cPanel-generated php ini directives, do not edit

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Forzar HTTPS.
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Consolidar en el dominio sin www, que es el canónico declarado en el HTML.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType video/mp4 .mp4
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # Los archivos bajo _next/static llevan un hash en el nombre, así que un
  # cambio genera un nombre nuevo y nunca hay que invalidar la caché.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(webp|jpg|jpeg|png|mp4|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # El HTML sí debe revalidarse, si no los cambios no se ven al republicar.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

ErrorDocument 404 /404.html
